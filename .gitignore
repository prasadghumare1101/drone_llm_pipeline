# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# ---- ROS 2 / colcon build output (regenerated by `colcon build`) ----
build/
install/
log/

# ---- Vendored upstream ROS packages (cloned separately; see README) ----
# px4_msgs / px4_ros_com / px4_offboard are upstream repos, not part of this
# project. The Docker sim image clones px4_msgs fresh at the pinned version.
# Leading slash = ONLY the repo-root src/ (NOT aero_gcs/frontend/src, which is
# the dashboard's own source and MUST be committed).
/src/

# ---- Node / frontend build ----
node_modules/
dist/
.vite/
npm-debug.log*

# ---- Mission run artifacts (generated at runtime) ----
runs/

# ---- Secrets / local env (NEVER commit tokens) ----
.env
*.env
!*.env.example

# ---- Editor / tooling / OS ----
.vscode/
.idea/
.claude/
.DS_Store
*.swp

# ---- Separate workspaces that sometimes sit alongside this one ----
ws_swarm/
ws_offboard_control/

# ---- aero_gcs basemap cache (generated from local Gazebo models) ----
aero_gcs/backend_services/cache/

# ---- real flight logs (large, private) - keep only the README ----
realFlight_logs/*
!realFlight_logs/README.md

# ---- worlds generated from real locations (rebuild with world_builder.py) ----
aero_gcs/sim_worlds/

# ---- runtime service logs (new ones; the few already tracked stay tracked) ----
aero_gcs/backend_services/logs/*.prev
aero_gcs/backend_services/logs/gui.log
aero_gcs/backend_services/logs/session.log
