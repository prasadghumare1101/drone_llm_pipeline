# =============================================================================
#  drone_llm_pipeline — FULL SIMULATION image (everything, nothing native)
#
#  Bakes the ENTIRE stack into one container:
#     * ROS 2 Humble  (from the osrf/ros base)
#     * Gazebo Classic 11 + gazebo_ros plugins  (GUI via X11 at run time)
#     * PX4-Autopilot SITL, built and pinned to the exact version this project uses
#     * the MODIFIED iris model (with front camera) — copied over the stock one
#     * MicroXRCE-DDS Agent (uXRCE-DDS bridge)
#     * px4_msgs (main) + this pipeline (LLM -> validate -> compile -> PX4 bridge)
#     * the aero_gcs control_api / telemetry / video backend
#
#  Nothing is installed on the host. The host only provides the kernel, an X
#  server (for the Gazebo GUI), and — optionally — an NVIDIA GPU for smooth
#  rendering. See docker/SIM_DOCKER.md for the run command.
#
#  Heads-up: large image (~8-10 GB) and a 30-45 min first build (PX4 compiles).
# =============================================================================

# ---- stage 0: build the dashboard UI (Node), so the final image ships the
#      static site and needs no Node toolchain at run time ----
FROM node:22-alpine AS ui
WORKDIR /ui
COPY aero_gcs/frontend/package.json aero_gcs/frontend/package-lock.json ./
RUN npm ci
COPY aero_gcs/frontend/ ./
RUN npm run build          # -> /ui/dist


# ROS 2 Humble + rviz2 already present. Ubuntu 22.04 userland == what ROS/PX4 target.
FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive \
    PX4_COMMIT=d2548ced9d \
    XRCE_AGENT_TAG=v2.4.3 \
    ROS_DISTRO=humble

SHELL ["/bin/bash", "-c"]

# ---------------------------------------------------------------------------
# 1) System + Gazebo Classic + PX4 build dependencies (one cached layer).
#    Gazebo Classic (gazebo11) + gazebo_ros plugins give the sim AND the ROS
#    camera/sensor topics the pipeline reads.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      git wget curl gnupg lsb-release ca-certificates sudo nano \
      build-essential cmake ninja-build g++ \
      python3-pip python3-dev python3-setuptools \
      gazebo libgazebo-dev ros-humble-gazebo-ros-pkgs ros-humble-gazebo-ros2-control \
      ros-humble-rosbridge-suite ros-humble-rmw-fastrtps-cpp \
      gstreamer1.0-plugins-bad gstreamer1.0-libav gstreamer1.0-gl \
      libgstreamer-plugins-base1.0-dev libeigen3-dev libopencv-dev \
      libxml2-utils dmidecode \
      python3-opencv \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 2) PX4 Python build deps. empy MUST be 3.3.x (PX4 main breaks on empy 4.x) —
#    this is the single most common PX4-in-Docker build conflict.
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir \
      "empy==3.3.4" pyros-genmsg jinja2 jsonschema kconfiglib packaging \
      toml numpy pandas pyserial cerberus pyyaml future lxml

# ---------------------------------------------------------------------------
# 3) MicroXRCE-DDS Agent (the PX4 <-> ROS 2 uXRCE bridge), built from source.
# ---------------------------------------------------------------------------
RUN git clone -b ${XRCE_AGENT_TAG} --depth 1 \
        https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /tmp/xrce \
    && cmake -S /tmp/xrce -B /tmp/xrce/build -DUAGENT_BUILD_EXECUTABLE=ON \
    && cmake --build /tmp/xrce/build -j"$(nproc)" --target install \
    && ldconfig && rm -rf /tmp/xrce

# ---------------------------------------------------------------------------
# 4) Clone + build PX4 SITL, pinned to the exact commit this project uses.
#    DONT_RUN=1 builds the firmware + the gazebo-classic plugins WITHOUT
#    launching the sim (which is what we want during an image build).
# ---------------------------------------------------------------------------
RUN git clone https://github.com/PX4/PX4-Autopilot.git /opt/PX4-Autopilot \
    && cd /opt/PX4-Autopilot \
    && git checkout ${PX4_COMMIT} \
    && git submodule update --init --recursive
RUN cd /opt/PX4-Autopilot && DONT_RUN=1 make px4_sitl gazebo-classic

# ---------------------------------------------------------------------------
# 5) Overlay the MODIFIED iris (front camera + sensor edits) over PX4's stock
#    one. iris.sdf.jinja is what sitl_multiple_run/sitl_run actually renders.
# ---------------------------------------------------------------------------
COPY docker/iris_model/ \
     /opt/PX4-Autopilot/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models/iris/

# ---------------------------------------------------------------------------
# 6) ROS 2 workspace: px4_msgs (main, to match the pinned PX4) + this pipeline's
#    backend, colcon-built.
# ---------------------------------------------------------------------------
RUN mkdir -p /opt/ros_ws/src \
    && git clone --depth 1 -b main https://github.com/PX4/px4_msgs.git /opt/ros_ws/src/px4_msgs \
    && source /opt/ros/humble/setup.bash \
    && cd /opt/ros_ws && colcon build --packages-select px4_msgs

# The pipeline itself (pure Python; needs px4_msgs on the path at run time).
# NOTE: one COPY per directory — a multi-source `COPY a b dest/` merges the
# directories' CONTENTS and would flatten the Python packages, breaking imports.
COPY run_pipeline.py /opt/drone_llm_pipeline/run_pipeline.py
COPY schema/         /opt/drone_llm_pipeline/schema/
COPY llm_layer/      /opt/drone_llm_pipeline/llm_layer/
COPY validator/      /opt/drone_llm_pipeline/validator/
COPY executor/       /opt/drone_llm_pipeline/executor/
COPY sim_bridge/     /opt/drone_llm_pipeline/sim_bridge/
COPY aero_gcs/backend_services/ /opt/drone_llm_pipeline/aero_gcs/backend_services/
RUN pip3 install --no-cache-dir "jsonschema>=4.17" fastapi "uvicorn[standard]"

# The built dashboard UI (from stage 0) — served as static files at run time.
COPY --from=ui /ui/dist /opt/frontend_dist

# control_api sources the workspace from <pipeline>/install; in the image the
# workspace lives at /opt/ros_ws. Symlink so its default path resolves.
RUN ln -sf /opt/ros_ws/install /opt/drone_llm_pipeline/install

# ---------------------------------------------------------------------------
# 7) Launch-reliability env (the lessons already proven in this project):
#    kill the online model DB (stops "Gazebo won't open" hangs), no pxh shell.
# ---------------------------------------------------------------------------
ENV GAZEBO_MODEL_DATABASE_URI="" \
    PX4_NO_FOLLOW_MODE=1 \
    QT_X11_NO_MITSHM=1 \
    PX4_DIR=/opt/PX4-Autopilot \
    FRONTEND_DIR=/opt/frontend_dist \
    PATH="/opt/PX4-Autopilot/build/px4_sitl_default/bin:${PATH}"

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 3000 = dashboard UI, 8000 = control_api, 8080 = video, 9090 = rosbridge,
# 8888/udp = uXRCE-DDS agent.
EXPOSE 3000 8000 8080 9090 8888/udp
ENTRYPOINT ["/entrypoint.sh"]
# Default: auto-start the dashboard (backend + UI). Just open the browser.
CMD ["dashboard"]
